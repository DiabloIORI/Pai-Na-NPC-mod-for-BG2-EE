COPY ~%MOD_FOLDER%/Druid/Hivemaster/spells/C0HIVEH1.spl~ ~override~
SAY NAME1 ~昆虫帷幕~
SAY UNIDENTIFIED_DESC ~昆虫帷幕
有了此能力，群巢大师永久被一群飞虫笼罩，几乎不可见。10 尺半径内伤到群巢大师的目标会遭这些昆虫反击：每 2 秒受 1 点伤害，护甲等级与命中率各降低 2，并在 2 轮内承受 100% 施法失败。~

ADD_PROJECTILE ~%MOD_FOLDER%/Druid/Hivemaster/spells/C0HVPRO1.PRO~

COPY_EXISTING ~C0HIVH1A.SPL~ OVERRIDE
  LPF ALTER_SPELL_HEADER
	INT_VAR
		header = 1
		projectile = C0HVPRO1
END

COPY ~%MOD_FOLDER%/Druid/Hivemaster/spells/C0HIVEH2.spl~ ~override~
SAY NAME1 ~召唤阿拉涅亚长者~
SAY UNIDENTIFIED_DESC ~召唤阿拉涅亚长者

等级：任务
射程：30 尺
持续：5 回合
施法时间：9
效果范围：特殊
豁免：无

本法术召唤一只强大的远古阿拉涅亚——一种能变形、拥有惊人奥术力量的蛛族。阿拉涅亚在群巢大师控制下留存 1 回合，可如同 20 级术士般施法。其近战攻击视同 +4 武器，造成 1d10 穿刺与 1d6 魔法伤害；若目标以 -5 不利通过死亡豁免失败，还每秒受 5 点毒伤害，持续 10 轮。~

COPY ~%MOD_FOLDER%/Druid/Hivemaster/spells/C0HVARAN.cre~ ~override~
SAY NAME1 ~阿拉涅亚长者~
SAY NAME2 ~阿拉涅亚长者~
  WRITE_ASCII 0x280 ~C0HVARAN~  #32
    WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~C0_ARANEA~))

