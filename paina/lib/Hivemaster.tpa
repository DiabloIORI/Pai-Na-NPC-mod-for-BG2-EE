COPY ~%MOD_FOLDER%/Druid/Hivemaster/2da~ ~override~
COPY ~%MOD_FOLDER%/Druid/Hivemaster/animations~ ~override~
COPY ~%MOD_FOLDER%/Druid/Hivemaster/spells~ ~override~

ACTION_DEFINE_ASSOCIATIVE_ARRAY aranea_anims_Exxx BEGIN
    ~aranea~ => ~C0_ARANEA~
  END
  ACTION_PHP_EACH aranea_anims_Exxx AS folder => symbol BEGIN
    ACTION_BASH_FOR ~%MOD_FOLDER%/Druid/Hivemaster/animations/%folder%~ ~.+\.bam~ ~%MOD_FOLDER%/Druid/Hivemaster/animations/%folder%~ ~.+\.bmp~ BEGIN
      COPY ~%BASH_FOR_FILESPEC%~ ~override~
    END
    LAF FIND_FREE_ANIM_SLOT INT_VAR slotMin = 0xE000 RET slot END
    LAF TO_HEX_NUMBER INT_VAR value = slot minDigits = 4 RET hexNumber END
    COPY ~%MOD_FOLDER%/Druid/Hivemaster/animations/%folder%/Exxx.ini~ ~override/%hexNumber%.ini~
    OUTER_SET EVAL ~slot_%folder%~ = slot   // save animation slot number for later
    APPEND ~ANIMATE.IDS~ ~0x%hexNumber% %symbol%~
END

ACTION_DEFINE_ASSOCIATIVE_ARRAY ice_spider_anims_8xxx BEGIN
    ~ice_spider~ => ~C0_ICE_SPIDER~
  END
  ACTION_PHP_EACH ice_spider_anims_8xxx AS folder => symbol BEGIN
    ACTION_BASH_FOR ~%MOD_FOLDER%/Druid/Hivemaster/animations/%folder%~ ~.+\.bam~ ~%MOD_FOLDER%/Druid/Hivemaster/animations/%folder%~ ~.+\.bmp~ BEGIN
      COPY ~%BASH_FOR_FILESPEC%~ ~override~
    END
    LAF FIND_FREE_ANIM_SLOT INT_VAR slotMin = 0x8000 RET slot END
    LAF TO_HEX_NUMBER INT_VAR value = slot minDigits = 4 RET hexNumber END
    COPY ~%MOD_FOLDER%/Druid/Hivemaster/animations/%folder%/8xxx.ini~ ~override/%hexNumber%.ini~
    OUTER_SET EVAL ~slot_%folder%~ = slot   // save animation slot number for later
    APPEND ~ANIMATE.IDS~ ~0x%hexNumber% %symbol%~
END

// PVRZ-based bams

ACTION_FOR_EACH bamFile IN ~MSPIINV.bam~ BEGIN
    COPY ~%MOD_FOLDER%/Druid/Hivemaster/animations/ice_spider/inv/%bamFile%~ ~override~
      LPF UPDATE_PVRZ_INDICES RET original_base_index new_base_index END
    ACTION_IF (original_base_index >= 0 AND new_base_index >= 0) BEGIN
      LAF INSTALL_PVRZ
      INT_VAR
        original_base_index = original_base_index
        new_base_index = new_base_index
      STR_VAR
        source_file = EVAL ~%MOD_FOLDER%/Druid/Hivemaster/pvrz/mos%original_base_index%.pvrz~
      END
    END
END
LAF ADD_KIT_EX
  INT_VAR
    // Mage	= 1
	// Fighter = 2
	// Cleric = 3
	// Thief = 4
	// Bard = 5
	// Paladin = 6
	// Fighter/Mage = 7
	// Fighter/Cleric = 8
	// Fighter/Thief = 9
	// Fighter/Mage/Thief = 10
	// Druid = 11
	// Ranger = 12
	// Mage/Thief = 13
	// Cleric/Mage = 14
	// Cleric/Thief = 15
	// Fighter/Druid = 16
	// Fighter/Mage/Cleric = 17
	// Cleric/Ranger = 18
	// Sorcerer = 19
	// Monk = 20
	// Shaman = 21
    kit_class     = 11
	
    mixed         = RESOLVE_STR_REF(~群巢大师~)
	
    lower         = RESOLVE_STR_REF(~群巢大师~)
	
    help          = RESOLVE_STR_REF(~群巢大师：群巢大师是专心养育并保护昆虫与蛛形类（含其巨大化的种类）的德鲁伊。他们多半仿效群居昆虫——如蚂蚁或蜜蜂（“群巢”之名即由此而来）——或蜘蛛、蝎子、蜻蜓之类的掠食者。

优势：
– 免疫所有毒素，以及下列法术：蛛网术、召唤昆虫、昆虫疫病、蔓延末日
– 有六个奥术加入<PRO_HISHER>的法术库，一直可用到六环。列表如下：
  1 环：目盲术。
  2 环：蛛网术。
  3 环：蛛皮术。
  4 环：召唤蜘蛛。
  5 环：死云术。
  6 环：腐尸召唤。
– 每日可使用一次“淬毒武器”能力。在第 7 级与第 14 级各多得一次使用。

淬毒武器：接下来 5 轮内，每次命中都会向目标注入毒。每个目标每轮只会受一次影响。毒素伤害量取决于角色等级：

1 级 - 目标每秒受 1 点毒伤害，持续 6 秒（以 +1 有利通过死亡豁免则免）
5 级 - 目标每秒受 1 点毒伤害，持续 12 秒（通过死亡豁免则免），并立即再受 2 点毒伤害（不可豁免）
9 级 - 目标每秒受 1 点毒伤害，持续 18 秒（以 -1 不利通过死亡豁免则免），并立即再受 4 点毒伤害（不可豁免）
13 级 - 目标每秒受 1 点毒伤害，持续 24 秒（以 -2 不利通过死亡豁免则免），并立即再受 6 点毒伤害（不可豁免）

– 第 7 级：每日一次可变形成小蜘蛛、相位蛛或剑蛛。

小蜘蛛：变形时隐形，力量 10、敏捷 18，每轮攻击两次，造成 1d2 穿刺伤害。目标须通过死亡豁免，否则中毒，每秒受 5 点伤害，持续 5 轮。

相位蛛：每轮可传送至一个指定生物；力量 14、敏捷 18，每轮攻击两次，造成 1d6 穿刺伤害。目标须通过死亡豁免，否则中毒，每秒受 2 点伤害，持续 3 轮。

剑蛛：永久处于加速状态；力量与敏捷 18，每轮攻击三次（不计加速），造成 1d10 挥砍伤害。

– 第 14 级：群巢大师可变形为霜蛛。

霜蛛：免疫非附魔武器与寒冷伤害；力量 19、敏捷 20，每轮攻击两次，造成 2d8 穿刺伤害与 1d10 寒冷伤害。目标须以 -2 不利通过死亡豁免，否则被减速并在 1 回合内失去 1 点力量。在近战距离伤到霜蛛的敌人会受 2d6 寒冷伤害。

劣势：
– 魅力 -3 惩罚。
– 不得穿着重于皮甲的衣服。
– 不得变形为默认的动物形态。~)
	
    briefdesc     = RESOLVE_STR_REF(~群巢大师：群巢大师是专心养育并保护昆虫与蛛形类（含其巨大化的种类）的德鲁伊。他们多半仿效群居昆虫——如蚂蚁或蜜蜂（“群巢”之名即由此而来）——或蜘蛛、蝎子、蜻蜓之类的掠食者。~)
	
	// fallen = 0
	
  STR_VAR
    kit_name      = ~C0HIVE~
	
    unusable      = ~0x20000000~
